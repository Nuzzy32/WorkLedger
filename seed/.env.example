# Local anvil (default). For Base Sepolia use https://sepolia.base.org
RPC_URL=http://127.0.0.1:8545

# 31337 = anvil, 84532 = Base Sepolia. Never a mainnet id.
CHAIN_ID=31337

# BIP-39 mnemonic that derives all 64 seed accounts.
# The value below is anvil's own public test mnemonic — safe for local use only.
# NEVER put a mnemonic that holds real value in this file.
MNEMONIC="test test test test test test test test test test test junk"

# Changing this changes every generated jobId, so the seed will insert a fresh
# dataset rather than resuming the previous one.
SEED_TAG=workledger-demo-v1

# Optional. When absent, the seed runs chain-only and skips all Postgres writes.
# DATABASE_URL=postgresql://user:password@host:5432/postgres

# Optional. Only needed to verify contract source on Basescan.
# BASESCAN_API_KEY=
